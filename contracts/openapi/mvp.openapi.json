{
  "openapi": "3.1.0",
  "info": {
    "title": "PAPA CODE MVP API",
    "version": "0.1.0",
    "description": "Consultation contracts for the frozen six-stage MVP. Clients render user_visible only. Profile is optional and is not a gate. No calendar sync, partner account, or production deployment is part of this contract."
  },
  "paths": {
    "/v1/consultations": {
      "post": {
        "operationId": "startConsultation",
        "summary": "Start a consultation from a home choice or free text.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/StartConsultationRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Next consultation turn. Render user_visible only.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ConsultationTurn"}
              }
            }
          }
        }
      }
    },
    "/v1/consultations/{consultation_id}/turns": {
      "post": {
        "operationId": "continueConsultation",
        "summary": "Add a short answer or another sentence to the active consultation.",
        "parameters": [
          {"$ref": "#/components/parameters/ConsultationId"}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ContinueConsultationRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Next consultation turn.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ConsultationTurn"}
              }
            }
          }
        }
      }
    },
    "/v1/consultations/{consultation_id}/outcomes": {
      "post": {
        "operationId": "recordOutcome",
        "summary": "Record what actually happened. This is the only write path for success and failure memory.",
        "parameters": [
          {"$ref": "#/components/parameters/ConsultationId"}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ConsultationOutcome"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback stored. Memory items are returned only when the outcome chain supports them.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/OutcomeResult"}
              }
            }
          }
        }
      }
    },
    "/v1/households/{household_id}/memory": {
      "get": {
        "operationId": "listMemory",
        "summary": "List outcome-backed memory in household language.",
        "parameters": [
          {"$ref": "#/components/parameters/HouseholdId"}
        ],
        "responses": {
          "200": {
            "description": "At most five current memory items for display.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 5,
                      "items": {"$ref": "#/components/schemas/MemoryItem"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/households/{household_id}/memory/{memory_id}/rejections": {
      "post": {
        "operationId": "rejectMemory",
        "summary": "Reject a previous pattern for the current situation.",
        "parameters": [
          {"$ref": "#/components/parameters/HouseholdId"},
          {
            "name": "memory_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "204": {"description": "Pattern rejected for this consultation."}
        }
      }
    },
    "/v1/households/{household_id}/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Read the optional household profile.",
        "parameters": [
          {"$ref": "#/components/parameters/HouseholdId"}
        ],
        "responses": {
          "200": {
            "description": "Sparse profile. Every field may be null.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HouseholdProfile"}
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchProfile",
        "summary": "Update profile fields the user already volunteered. Not required before the first consultation.",
        "parameters": [
          {"$ref": "#/components/parameters/HouseholdId"}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/HouseholdProfilePatch"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated sparse profile.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HouseholdProfile"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ConsultationId": {
        "name": "consultation_id",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "HouseholdId": {
        "name": "household_id",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      }
    },
    "schemas": {
      "Intent": {
        "type": "string",
        "enum": [
          "WHAT_SHOULD_I_DO",
          "TIRED",
          "WANT_TO_DRINK",
          "WANT_PERSONAL_TIME",
          "PARTNER_UNHAPPY_OR_CONFLICT",
          "OVERTIME",
          "FREE_CONSULT"
        ]
      },
      "ContextMode": {
        "type": "string",
        "enum": [
          "HOUSEHOLD_IMPACT",
          "PRIORITY",
          "CAPACITY",
          "TIME_OPPORTUNITY",
          "SITUATION_SUMMARY",
          "ROUTED_CONTEXT"
        ]
      },
      "ActionType": {
        "type": "string",
        "enum": [
          "DO_NOW",
          "PREPARE_AHEAD",
          "REST",
          "DEFER",
          "SKIP",
          "COMMUNICATE",
          "SUBSTITUTE",
          "RECOVER"
        ]
      },
      "Stage": {
        "type": "string",
        "enum": ["HOME", "CLARIFY", "CONTEXT", "ACTION", "FEEDBACK", "MEMORY"]
      },
      "StartConsultationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["household_id", "user_id", "source"],
        "properties": {
          "household_id": {"type": "string", "format": "uuid"},
          "user_id": {"type": "string", "format": "uuid"},
          "source": {"type": "string", "enum": ["HOME_CHOICE", "FREE_TEXT"]},
          "entry_choice": {"type": ["string", "null"]},
          "raw_user_input": {"type": ["string", "null"]},
          "known_context": {"type": "object"},
          "reported_facts": {"type": "array", "items": {"type": "string"}}
        }
      },
      "ContinueConsultationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["answers"],
        "properties": {
          "answers": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key"],
              "properties": {
                "key": {"type": "string"},
                "value": {}
              }
            }
          },
          "raw_user_input": {"type": ["string", "null"]}
        }
      },
      "ConsultationTurn": {
        "type": "object",
        "required": ["stage", "user_visible", "audit"],
        "properties": {
          "stage": {"type": "string", "enum": ["CLARIFY", "ACTION"]},
          "user_visible": {"type": "object"},
          "audit": {
            "type": "object",
            "description": "Server and test use only. Clients do not render this object."
          }
        }
      },
      "ConsultationOutcome": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actions_executed", "household_load_outcome", "reusable_next_time"],
        "properties": {
          "intent_executed": {"type": ["boolean", "null"]},
          "actions_executed": {"type": "array", "items": {"type": "string"}},
          "household_load_outcome": {
            "type": "string",
            "enum": ["LIGHTER", "SAME", "HEAVIER", "UNKNOWN"]
          },
          "partner_response_user_reported": {"type": ["string", "null"]},
          "user_burden": {"type": ["string", "null"]},
          "household_atmosphere_user_reported": {"type": ["string", "null"]},
          "reusable_next_time": {"type": ["boolean", "null"]},
          "free_note": {"type": ["string", "null"]}
        }
      },
      "OutcomeResult": {
        "type": "object",
        "required": ["stage", "memories"],
        "properties": {
          "stage": {"type": "string", "enum": ["FEEDBACK", "MEMORY"]},
          "memories": {"type": "array", "items": {"$ref": "#/components/schemas/MemoryItem"}}
        }
      },
      "MemoryItem": {
        "type": "object",
        "required": ["memory_type", "statement", "outcome_backed"],
        "properties": {
          "memory_type": {
            "type": "string",
            "enum": [
              "HOUSEHOLD_ATTRIBUTE",
              "ROUTINE",
              "TASK_OWNERSHIP",
              "PREFERENCE",
              "FATIGUE_PATTERN",
              "CONFLICT_PATTERN",
              "SUCCESS_PATTERN",
              "FAILURE_PATTERN",
              "SCHEDULE_PATTERN"
            ]
          },
          "statement": {"type": "string"},
          "outcome_backed": {"type": "boolean"}
        }
      },
      "HouseholdProfile": {
        "type": "object",
        "description": "Every field is optional. Missing fields stay unknown.",
        "properties": {
          "weekday_routine": {"type": ["string", "null"]},
          "weekend_routine": {"type": ["string", "null"]},
          "childcare_arrangement": {"type": ["string", "null"]},
          "usual_task_ownership": {"type": ["string", "null"]},
          "wake_time": {"type": ["string", "null"]},
          "child_bedtime": {"type": ["string", "null"]},
          "daycare_school_constraints": {"type": ["string", "null"]},
          "known_preferences": {"type": ["string", "null"]},
          "known_no_go_conditions": {"type": ["string", "null"]}
        }
      },
      "HouseholdProfilePatch": {
        "type": "object",
        "description": "Partial update. Omitted keys are left untouched.",
        "properties": {
          "weekday_routine": {"type": ["string", "null"]},
          "weekend_routine": {"type": ["string", "null"]},
          "childcare_arrangement": {"type": ["string", "null"]},
          "usual_task_ownership": {"type": ["string", "null"]},
          "wake_time": {"type": ["string", "null"]},
          "child_bedtime": {"type": ["string", "null"]},
          "daycare_school_constraints": {"type": ["string", "null"]},
          "known_preferences": {"type": ["string", "null"]},
          "known_no_go_conditions": {"type": ["string", "null"]}
        }
      }
    }
  }
}
