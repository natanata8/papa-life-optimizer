# クライアント（Vite）。未設定なら localStorage とサンプル回答で動きます。
# anon key は公開されてよい鍵です。service role と OpenAI の鍵はここに置かないでください。

# local（既定） | supabase
VITE_DATA=local
# sample（既定） | supabase
VITE_AI=sample
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# GitHub Pages では /リポジトリ名/ 。ローカルは空でよい。
VITE_BASE=/
# false にすると時間帯の切り替えと「最初から」を隠します。
VITE_DEMO_MODE=true

# サーバだけ（Supabase の secrets。クライアントに渡さない）
# supabase secrets set OPENAI_API_KEY=... OPENAI_MODEL=gpt-6-luna CONSULT_DAILY_CAP=20
# タスク投入だけ: SUPABASE_URL と SUPABASE_SERVICE_ROLE_KEY をシェルに渡して npm run seed:tasks
